{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "weft values",
  "description": "Validated at install and upgrade time, so a mistyped value fails before the controller is deployed rather than as a crash-loop afterwards.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "crds": {
      "type": "object",
      "properties": {
        "install": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "allowUnrestrictedGroupImpersonation": { "type": "boolean" },
        "impersonation": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": ["cluster", "namespaced"]
            },
            "namespaces": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "watchNamespace": { "type": "string" },
        "leaderElection": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "impersonateGroups": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pruneDelay": { "$ref": "#/definitions/duration" },
        "pruneThreshold": { "type": "integer", "minimum": 1 },
        "sourceFinalizerTimeout": { "$ref": "#/definitions/duration" },
        "teardownTimeout": { "$ref": "#/definitions/duration" },
        "pollInterval": { "$ref": "#/definitions/duration" },
        "backstopInterval": { "$ref": "#/definitions/duration" },
        "degradedRetry": { "$ref": "#/definitions/duration" },
        "evaluator": {
          "type": "object",
          "properties": {
            "maxSteps": { "type": "integer", "minimum": 1000 },
            "maxResources": { "type": "integer", "minimum": 1 },
            "maxValues": { "type": "integer", "minimum": 1 },
            "programCacheSize": { "type": "integer", "minimum": 1 }
          }
        },
        "watches": {
          "type": "object",
          "properties": {
            "resync": { "$ref": "#/definitions/duration" },
            "lifetime": { "$ref": "#/definitions/duration" }
          }
        },
        "log": {
          "type": "object",
          "properties": {
            "level": { "type": "string", "minLength": 1 },
            "encoder": { "type": "string", "enum": ["json", "console"] },
            "stacktraceLevel": {
              "type": "string",
              "enum": ["info", "error", "panic"]
            }
          }
        },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/port" },
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "$ref": "#/definitions/port" },
            "annotations": { "type": "object" },
            "labels": { "type": "object" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "$ref": "#/definitions/duration" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" },
            "annotations": { "type": "object" },
            "honorLabels": { "type": "boolean" },
            "relabelings": { "type": "array" },
            "metricRelabelings": { "type": "array" }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "dnsPolicy": { "type": "string" },
    "dnsConfig": { "type": "object" },
    "hostAliases": { "type": "array" }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "description": "A Go duration, such as 30s, 10m or 1h30m.",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
